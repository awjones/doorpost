# Copy to .env (chmod 600). Never commit .env.

# Private iCal addresses (Google Calendar > Settings > calendar > Integrate calendar).
# Easier: paste them in Settings > Calendars instead. Apple iCloud, Outlook and
# other calendars are set up there too. See docs/calendars.md.
CAL_FAMILY_ICS=
CAL_KIDS_ICS=
CAL_DAD_ICS=

# A parent login for the screen time app, used to credit approved chores.
SCREEN_TIME_EMAIL=
SCREEN_TIME_PASSWORD=

# Home Assistant long-lived access token (Profile > Security), if home_assistant.enabled
HA_TOKEN=

# Set these with:  python -m app.tools set-pin   and   python -m app.tools new-secret
FRAME_PIN_HASH=
FRAME_SECRET=

# NWS asks for a contact in the User-Agent
WEATHER_USER_AGENT=doorpost (your-email@example.com)

# FRAME_DEMO=1 runs with sample data and PIN 1234
# FRAME_DEMO=
